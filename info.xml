<?xml version="1.0"?>
<extension key="com.jlacey.electoral" type="module">
  <file>electoral</file>
  <name>Electoral API - legacy fork</name>
  <description>Electoral API integration</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Joseph Lacey</author>
    <email>joseph@mayfirst.org</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/josephlacey/com.jlacey.electoral</url>
    <url desc="Support">https://github.com/josephlacey/com.jlacey.electoral/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2025-08-04</releaseDate>
  <version>2.1.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.38</ver>
  </compatibility>
  <comments>This module provides integration to various electoral API's.  Currently included API's are Google's Civic Information API and the Open States API.  It's development has been funded by the Center for Constitional Rights and 9to5.</comments>
  <civix>
    <namespace>CRM/Electoral</namespace>
    <format>25.01.1</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Electoral\AutomaticUpgrader</upgrader>
</extension>
